{
  "name": "staff-pulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prestart": "node scripts/prepare-docker.mjs",
    "start": "docker compose up --build --force-recreate --remove-orphans",
    "prestart:ai": "node scripts/prepare-docker.mjs",
    "start:ai": "docker compose -f docker-compose.yml -f docker-compose.ai.yml up --build --force-recreate --remove-orphans",
    "prestart:ai:gpu": "node scripts/prepare-docker.mjs",
    "start:ai:gpu": "docker compose -f docker-compose.yml -f docker-compose.ai.yml -f docker-compose.gpu.yml up --build --force-recreate --remove-orphans",
    "stop": "docker compose -f docker-compose.yml -f docker-compose.ai.yml down --remove-orphans",
    "dev": "concurrently -k -n api,web \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/prepare-model.test.mjs scripts/prepare-docker.test.mjs scripts/serve-model.test.mjs",
    "test:watch": "vitest",
    "test:search-model": "node scripts/evaluate-search.mjs",
    "build": "npm run typecheck && npm run build:client && npm run build:server && npm run check:size",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist-server/index.mjs",
    "build:client": "vite build",
    "check:size": "node scripts/check-size.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
