{
  "version": 2,
  "description": "Independent final challenge prepared before model selection was frozen. Only each case's query is sent to the model; domainNotes document client semantics, not prompt hints.",
  "domainNotes": [
    "Ranking does not imply a positive-value predicate: zero-valued nodes remain eligible.",
    "Unknown aggregate performance is null. It fails every numeric predicate, including ne, and sorts after known values in either direction.",
    "Expected filters describe query semantics independently of the current company dataset."
  ],
  "cases": [
    {
      "id": "challenge-level-second",
      "group": "level-name",
      "query": "Ограничь список подразделениями второго уровня.",
      "expected": {
        "source": "ai",
        "filter": {
          "groups": [[{ "field": "level", "op": "eq", "value": 2 }]],
          "sort": null,
          "limit": null
        }
      }
    },
    {
      "id": "challenge-team-name-fragment",
      "group": "level-name",
      "query": "В списке команд оставь названия с фрагментом «инфра».",
      "expected": {
        "source": "ai",
        "filter": {
          "groups": [
            [
              { "field": "level", "op": "eq", "value": 3 },
              { "field": "name", "op": "contains", "value": "инфра" }
            ]
          ],
          "sort": null,
          "limit": null
        }
      }
    },
    {
